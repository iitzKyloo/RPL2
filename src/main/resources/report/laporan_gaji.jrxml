<!-- Created with Jaspersoft Studio version 7.0.8.final using JasperReports Library version 7.0.8-6f896111  -->
<jasperReport name="laporan_gaji" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c9dbebc4-baf7-463c-86a7-12ea3424680f">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="simka"/>
	<parameter name="PERIODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT k.nama, j.nama_jabatan, g.periode, g.gaji_pokok, g.tunjangan, g.potongan,
       (g.gaji_pokok + g.tunjangan - g.potongan) AS total
FROM gaji g
JOIN karyawan k ON g.id_karyawan = k.id_karyawan
JOIN jabatan j ON k.id_jabatan = j.id_jabatan
WHERE $P{PERIODE} IS NULL OR g.periode = $P{PERIODE}
ORDER BY g.periode DESC, k.nama]]></query>
	<field name="nama" class="java.lang.String"/>
	<field name="nama_jabatan" class="java.lang.String"/>
	<field name="periode" class="java.lang.String"/>
	<field name="gaji_pokok" class="java.math.BigDecimal"/>
	<field name="tunjangan" class="java.math.BigDecimal"/>
	<field name="potongan" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="TOTAL_SEMUA" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{total}]]></expression>
	</variable>
